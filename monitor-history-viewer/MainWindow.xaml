<Window x:Class="MonitorHistoryViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="历史数据查询"
        Height="700" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        Icon="favicon.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 服务器配置 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="服务器：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="HostTextBox" Width="130" VerticalAlignment="Center" Margin="0,0,5,0"
                     Background="#252540" Foreground="White" BorderBrush="#444" Padding="4,2"/>
            <TextBox x:Name="PortTextBox" Width="50" VerticalAlignment="Center" Margin="0,0,5,0"
                     Background="#252540" Foreground="White" BorderBrush="#444" Padding="4,2"/>
            <Button Content="保存" Click="SaveServer_Click" Padding="10,2"
                    Background="#2a4a6a" Foreground="White" BorderBrush="#444"/>
        </StackPanel>

        <!-- 床号选择：分两排每排4个，上下对齐 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="床位：" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <RadioButton x:Name="Bed1Radio" Grid.Row="0" Grid.Column="1" Content="1床" GroupName="BedGroup" IsChecked="True" 
                         Foreground="White" HorizontalAlignment="Center" Click="BedRadio_Click"/>
            <RadioButton x:Name="Bed2Radio" Grid.Row="0" Grid.Column="2" Content="2床" GroupName="BedGroup" 
                         Foreground="White" HorizontalAlignment="Center" Click="BedRadio_Click"/>
            <RadioButton x:Name="Bed3Radio" Grid.Row="0" Grid.Column="3" Content="3床" GroupName="BedGroup" 
                         Foreground="White" HorizontalAlignment="Center" Click="BedRadio_Click"/>
            <RadioButton x:Name="Bed4Radio" Grid.Row="0" Grid.Column="4" Content="4床" GroupName="BedGroup" 
                         Foreground="White" HorizontalAlignment="Center" Click="BedRadio_Click"/>
            <RadioButton x:Name="Bed5Radio" Grid.Row="1" Grid.Column="1" Content="5床" GroupName="BedGroup" 
                         Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0" Click="BedRadio_Click"/>
            <RadioButton x:Name="Bed6Radio" Grid.Row="1" Grid.Column="2" Content="6床" GroupName="BedGroup" 
                         Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0" Click="BedRadio_Click"/>
            <RadioButton x:Name="Bed7Radio" Grid.Row="1" Grid.Column="3" Content="7床" GroupName="BedGroup" 
                         Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0" Click="BedRadio_Click"/>
            <RadioButton x:Name="Bed8Radio" Grid.Row="1" Grid.Column="4" Content="8床" GroupName="BedGroup" 
                         Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0" Click="BedRadio_Click"/>
        </Grid>

        <!-- 第二行：时间间隔单选框 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,10">
            <TextBlock Text="时间间隔：" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton x:Name="Interval5Radio" Content="5分钟" GroupName="IntervalGroup" 
                         Foreground="White" Margin="0,0,15,0" Click="IntervalRadio_Click"/>
            <RadioButton x:Name="Interval30Radio" Content="30分钟" GroupName="IntervalGroup" IsChecked="True"
                         Foreground="White" Margin="0,0,15,0" Click="IntervalRadio_Click"/>
            <RadioButton x:Name="Interval60Radio" Content="60分钟" GroupName="IntervalGroup" 
                         Foreground="White" Margin="0,0,15,0" Click="IntervalRadio_Click"/>
        </StackPanel>

        <!-- 时间范围选择 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="开始：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="StartDatePicker" Width="110" VerticalAlignment="Center" Margin="0,0,5,0"
                        Background="#252540" BorderBrush="#444"/>
            <TextBox x:Name="StartTimeTextBox" Width="50" VerticalAlignment="Center"
                     Background="#252540" Foreground="White" BorderBrush="#444" Padding="4,2"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="结束：" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="EndDatePicker" Width="110" VerticalAlignment="Center" Margin="0,0,5,0"
                        Background="#252540" BorderBrush="#444"/>
            <TextBox x:Name="EndTimeTextBox" Width="50" VerticalAlignment="Center"
                     Background="#252540" Foreground="White" BorderBrush="#444" Padding="4,2"/>
            <Button Content="查询" Click="QueryButton_Click" Padding="10,2" Margin="10,0,0,0"
                    Background="#2a4a6a" Foreground="White" BorderBrush="#444"/>
        </StackPanel>

        <!-- 数据表格 -->
        <DataGrid Grid.Row="5"
                  x:Name="DataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="#1a1a2e"
                  Foreground="White"
                  BorderBrush="#333"
                  RowBackground="#1a1a2e"
                  AlternatingRowBackground="#252540"
                  HorizontalGridLinesBrush="#333"
                  RowHeight="45"
                  CanUserSortColumns="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <DataGrid.GroupStyle>
                <!-- 按日期分组的标题栏：跨日数据（如 23:00 后接次日 00:00）通过日期标题栏区分 -->
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#1e3a5f" Padding="10,4" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#7ecbff"
                                           FontSize="14"
                                           FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2a4a6a"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10,12"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderBrush" Value="#444"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,20"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding TimeDisplay}" Width="60"/>
                <DataGridTextColumn Header="P" Binding="{Binding HeartRateDisplay}" Width="45">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#00ff00"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="R" Binding="{Binding RespRateDisplay}" Width="45">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#ffff00"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="IBP" Binding="{Binding IbpDisplay}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#ff0000"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="NIBP" Binding="{Binding NibpDisplay}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SP" Binding="{Binding Spo2Display}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#00ffff"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <Grid Grid.Row="6" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="StatusText"
                       Text="就绪 - 请选择床位查看数据"
                       Foreground="#888"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       x:Name="RecordCountText"
                       Text="共 0 条记录"
                       Foreground="#888"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>